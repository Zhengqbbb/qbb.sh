---
import { pwaInfo } from 'virtual:pwa-info'
import { getImageUrl } from '~/lib/server'
import Meta from '~/meta'

const {
    title = Meta.title,
    desc = Meta.description,
    image,
} = Astro.props

const ogImg = image ? getImageUrl(image) : Meta.ogImg
---

<title>{title}</title>
<meta name="description" content={desc} />
<meta name="theme-color" content="#0a0a0a" />
<Fragment set:html={import.meta.env.INJECT_BEFORE_HEAD_INLINE_SCRIPT} />
<meta name="keywords" content={Meta.keywords} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<meta name="application-name" content={Meta.appName} />
<meta name="apple-mobile-web-app-title" content={Meta.title} />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<link rel="apple-touch-icon" href="/apple-touch-120x120.png" />
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#aaaaaa" />
<link rel="alternate" type="application/rss+xml" href={`${Meta.site}/feed.xml`} />
<link rel="sitemap" type="application/xml" href={`${Meta.site}/sitemap-index.xml`} />
<meta name="author" content="Q.Ben Zheng" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={Meta.twitterCreator} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImg} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:image" content={ogImg} />
<meta property="og:type" content="website" />
<meta property="og:url" content={Meta.site} />
<meta name="generator" content={Astro.generator} />
{ pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }
<Fragment set:html={import.meta.env.INJECT_AFTRE_HEAD_INLINE_SCRIPT} />
<Fragment set:html={import.meta.env.HEAD_INJECT} />
