---
import SquareLine from './SquareLine.astro'
---

<div
    id="bg-un-gradient"
    style="--bg-un-gradient: hsl(var(--c-bg) / 0.5) 50%, transparent 90%, transparent 100%; filter: blur(1px); z-index: -1;"
    class="absolute h-auto w-full"
>
    <div
        class="absolute left-0 top-0 h-auto w-1/2 bg-neutral-100 dark:bg-neutral-800"
    >
        <div
            class="pointer-events-none absolute inset-0 z-30 h-full w-full bg-gradient-to-tl"
            style="--un-gradient-stops: var(--bg-un-gradient);"
        >
        </div>
        <div
            class="h-full w-full flex flex-col border-l border-t border-neutral-300 border-dashed divide-y divide-neutral-300 divide-dashed dark:border-neutral-900 dark:divide-neutral-700"
        >
            <SquareLine />
            <SquareLine />
            <SquareLine />
            <SquareLine />
            <SquareLine />
            <SquareLine />
        </div>
    </div>

    <div
        class="absolute right-0 top-0 h-auto w-1/2 bg-neutral-100 dark:bg-neutral-800"
    >
        <div
            class="pointer-events-none absolute inset-0 z-30 h-full w-full bg-gradient-to-tr"
            style="--un-gradient-stops: var(--bg-un-gradient);"
        >
        </div>
        <div
            class="h-full w-full flex flex-col border-l border-t border-neutral-300 border-dashed divide-y divide-neutral-300 divide-dashed dark:border-neutral-900 dark:divide-neutral-700"
        >
            <SquareLine />
            <SquareLine />
            <SquareLine />
            <SquareLine />
            <SquareLine />
            <SquareLine />
        </div>
    </div>
</div>

