---
import Square from './Square.astro'
---

<div
    class="sq-row relative w-full flex shrink-0 items-stretch divide-x divide-c-border divide-dashed"
>
    <Square />
    <Square />
    <Square />
    <Square />
    <Square />
    <Square />
    <Square />
    <Square />
</div>

<style>
    .sq-row {
        height: 30px;
    }
    @media (min-width: 640px) {
        .sq-row {
            height: 45px;
        }
    }
    @media (min-width: 768px) {
        .sq-row {
            height: 60px;
        }
    }
    @media (min-width: 1280px) {
        .sq-row {
            height: 88px;
        }
    }
</style>
