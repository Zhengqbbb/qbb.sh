{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["esnext", "dom"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "types": [
      "vite-plugin-pwa/vanillajs",
      "vite-plugin-pwa/info"
    ],
    "alwaysStrict": false
  },
  "include": ["src/**/*.astro", "src/**/*.ts", ".x-cmd/**/*.ts"]
}
