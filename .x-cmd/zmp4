# shellcheck shell=dash disable=SC2016

###
 # compressing all mp4 files in /public/ directory
 #
 # @powered by: X-CMD
 # @see: https://www.x-cmd.com/mod/ws
 # @usage: `xw zmp4`                 - All /public/*.mp4 files
###

(
    # Section: Arg
    WORK_DIR="$(x wsroot)"

    # Section: Main
    command find "$WORK_DIR/public/" -type f  -name '*.mp4' | x arg1 '
        x ffmpeg \
            -i "$1"                 \
            -c:v libx264            \
            -crf 30 -r 24           \
            -movflags faststart     \
            -c:a aac                \
            -b:a 128k               \
            -preset superfast       \
            "${1%.*}_compressed.mp4" || exit 1
    '
)
