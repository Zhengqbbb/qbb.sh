# shellcheck shell=dash

(
    ###
    # transform vercel.yml to vercel.json
    # > Emmmm. Actually, I really don't like vercel configure is JSON format.
    #
    # @powered by: X-CMD
    # @see: https://www.x-cmd.com/mod/ws
    # @usage: `xw vercel`
    ###
    # Section: Arg
    WORK_DIR="$(x wsroot)"

    # Section: Main
    x y2j < "${WORK_DIR}/.x-cmd/vercel.yml" > "${WORK_DIR}/vercel.json"
)
